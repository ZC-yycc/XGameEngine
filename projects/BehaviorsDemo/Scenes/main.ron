(
    name: "Behaviors Demo",
    entities: [
        (
            name: "Ground",
            transform: (
                position: (0.0, -0.5, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (24.0, 1.0, 24.0),
            ),
            model: "builtin://cube",
            id: (1),
            parent: None,
            physics: Some((
                kind: Static,
                shape: Cuboid(
                    half_extents: (12.0, 0.5, 12.0),
                ),
                mass: 0.0,
                friction: 0.7,
                restitution: 0.0,
                gravity_scale: 1.0,
                is_sensor: false,
            )),
        ),
        // ── Rust 轨道 ──────────────────────────────────────────────
        // `behaviors` 存的是**注册表里的组件名**，与 `scripts` 存路径完全同款
        // 的兼容模型：旧场景文件没这个字段 ⇒ 空列表（零行为）。
        (
            name: "RustSpinner",
            transform: (
                position: (-3.0, 1.5, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.5, 1.5, 1.5),
            ),
            model: "builtin://cube",
            id: (2),
            parent: None,
            behaviors: [
                "Spinner",
            ],
        ),
        (
            name: "RustBobber",
            transform: (
                position: (0.0, 2.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.5, 1.5, 1.5),
            ),
            model: "builtin://sphere",
            id: (3),
            parent: None,
            behaviors: [
                "Bobber",
            ],
        ),
        // ── Lua 脚本轨道（共存证明）──────────────────────────────────
        // 同一个运行时、同一份 `World::update`，两条轨道各跑各的、互不干扰。
        // 这个实体在**没编译过插件**时也照样转 —— 那正是降级语义：
        // Rust 组件缺席只是"少了两个会动的东西"，场景不会崩。
        (
            name: "LuaSpinner",
            transform: (
                position: (3.0, 1.5, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.5, 1.5, 1.5),
            ),
            model: "builtin://cube",
            id: (4),
            parent: None,
            scripts: [
                "guid://e1ea0ec292aab394364a94e4e17cc625",
            ],
        ),
    ],
    lights: [
        (
            name: "Sun",
            kind: Directional,
            direction: (0.45, -1.0, 0.35),
            position: (0.0, 0.0, 0.0),
            color: (1.0, 0.97, 0.92),
            intensity: 3.2,
            range: 10.0,
            casts_shadow: true,
            shadow_resolution: 0,
        ),
    ],
    ambient: (0.09, 0.1, 0.13),
)
