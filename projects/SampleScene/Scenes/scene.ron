            color: (1.0, 0.97, 0.92),
            // 3.2 是 Blinn-Phong 时代"白模也要亮"的手调值；PBR 落地 + 场景材质
            // 上色后回调到 1.4 —— 受光面落在"高光但不死白"的区间，阴影对比正常。
            intensity: 1.4,
            range: 10.0,
            casts_shadow: true,
            shadow_resolution: 0,
        ),
