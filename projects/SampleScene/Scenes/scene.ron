        (
            name: "Fox",
            transform: (
                position: (0.0, 0.0, 1.8),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (0.01, 0.01, 0.01),
            ),
            model: "guid://247e6655b676415d6c77cb91ceb3281b",
            id: (14),
            parent: None,
            animator: Some((
                clip: "Walk",
                speed: 1.0,
                looping: true,
                autoplay: true,
                fade_time: 0.25,
                machine: Some((
                    entry: "Idle",
                    parameters: { "speed": 0.0 },
                    states: [
                        (name: "Idle", clip: "Survey", speed: 1.0, looping: true),
                        (name: "Walk", clip: "Walk", speed: 1.0, looping: true),
                        (name: "Run", clip: "Run", speed: 1.0, looping: true),
                    ],
                    transitions: [
                        (from: "Idle", to: "Walk", when: AtLeast(param: "speed", value: 0.5)),
                        (from: "Walk", to: "Idle", when: Below(param: "speed", value: 0.3)),
                        (from: "Walk", to: "Run", when: AtLeast(param: "speed", value: 2.0)),
                        (from: "Run", to: "Walk", when: Below(param: "speed", value: 1.8)),
                    ],
                )),
                // 叠加层：把 Run 的**增量**（相对它第 0 帧的奔跑弹跳）叠在任意
                // 基础状态上 —— 权重由 FoxLocomotion.lua 每帧振荡，跑动时的
                // "呼吸/弹跳幅度"看得见地起伏（weight 0 = 无增量）。
                additive: Some((
                    clip: "Run",
                    weight: 0.3,
                    speed: 1.5,
                    looping: true,
                )),
                // 层栈（混合层 v1）：走路段给上半身盖一层 Survey ——
                // Override 模式 + 骨骼遮罩 ["b_Spine01_02"]（该骨及其全部子孙 =
                // 脊柱/颈/头/双臂，尾巴和腿不被盖），腿照走、上半身张望。
                // 权重由脚本按段推（走时 0.6、其他段 0），见 FoxLocomotion.lua。
                layers: [
                    (
                        name: "upper",
                        mode: Override,
                        clip: "Survey",
                        weight: 0.0,
                        speed: 1.0,
                        looping: true,
                        mask: ["b_Spine01_02"],
                    ),
                ],
            )),
            scripts: [
                "guid://58a14f446aa341711d5d7b75806b8ecc",
            ],
        ),

