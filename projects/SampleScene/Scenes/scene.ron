// SampleScene —— 引擎能力的演示场景。
//
// 想看出每个实体在演示什么，看 `name` 上的注释（RON 支持 `//` 行注释）。
//
// 几个刻意的设计：
//   · **物理要显式声明**。`physics: None`（不写这个字段）= 纯视觉实体，不会被
//     重力拽走。地面 / 平台 / 可推的箱子各自是什么，由场景作者说了算。
//   · **脚本只存路径**。多个实体挂同一个 `.rhai`，改一次逻辑全部生效。
//   · 动态体由物理驱动、运动学体由脚本驱动（见 `xgame-runtime` 的帧序说明）。
(
    name: "Test Scene",
    entities: [
        // -- 地面：静态盒子。没有它，下面所有动态物体都会无限下坠 --
        (
            name: "Ground",
            transform: (
                position: (0.0, -0.5, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (24.0, 1.0, 24.0),
            ),
            model: "builtin://cube",
            id: (1),
            parent: None,
            physics: Some((
                kind: Static,
                // 注意：RON 里**定长数组/元组**写成 `(...)`，`[...]` 是变长序列。
                // `half_extents` 是 `[f32; 3]`，所以用圆括号。
                shape: Cuboid(half_extents: (12.0, 0.5, 12.0)),
                friction: 0.7,
            )),
        ),

        // -- 静态台阶：纯装饰 + 静态碰撞，演示"父节点带子节点一起立住" --
        (
            name: "Platform",
            transform: (
                position: (-5.0, 0.5, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            model: "builtin://cube",
            id: (2),
            parent: None,
            physics: Some((kind: Static, shape: Auto)),
        ),
        (
            name: "Platform.Mid",
            transform: (
                position: (0.0, 1.05, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (0.8, 0.8, 0.8),
            ),
            model: "builtin://cube",
            id: (3),
            parent: Some((2)),
            physics: Some((kind: Static, shape: Auto)),
        ),
        (
            name: "Platform.Top",
            transform: (
                position: (0.0, 1.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (0.6, 0.6, 0.6),
            ),
            model: "builtin://cube",
            id: (4),
            parent: Some((3)),
            physics: Some((kind: Static, shape: Auto)),
        ),

        // -- 脚本演示 ①：运动学立方体，由 Spinner.rhai 每帧改旋转 --
        //    运动学体的位置 / 朝向由脚本负责，物理只负责把它推给别人。
        (
            name: "Spinner",
            transform: (
                position: (0.0, 1.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            model: "builtin://cube",
            id: (5),
            parent: None,
            scripts: ["Scripts/Spinner.rhai"],
            physics: Some((kind: Kinematic, shape: Auto)),
        ),

        // -- 脚本演示 ②：动态球，由 Jumper.rhai 响应「Jump」把它弹起来 --
        //    动态体由物理驱动，脚本只通过 `set_velocity` 施加影响 ——
        //    这条分工让"脚本改位置"和"重力算位置"不会互相覆盖。
        (
            name: "Bouncer",
            transform: (
                position: (4.0, 1.0, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            model: "builtin://sphere",
            id: (6),
            parent: None,
            scripts: ["Scripts/Jumper.rhai"],
            physics: Some((
                kind: Dynamic,
                shape: Ball(radius: 0.5),
                restitution: 0.55,
                friction: 0.4,
            )),
        ),

        // -- 自由落体：几个动态箱子，用于确认刚体与静止的接触解算 --
        (
            name: "Crate.A",
            transform: (
                position: (-1.5, 7.0, 1.5),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            model: "builtin://cube",
            id: (7),
            parent: None,
            physics: Some((kind: Dynamic, shape: Auto, friction: 0.6)),
        ),
        (
            name: "Crate.B",
            transform: (
                position: (1.5, 9.0, -1.5),
                rotation: (0.2, 0.0, 0.0, 0.98),
                scale: (1.2, 1.2, 1.2),
            ),
            model: "builtin://cube",
            id: (8),
            parent: None,
            physics: Some((kind: Dynamic, shape: Auto, friction: 0.6)),
        ),
        (
            name: "Crate.C",
            transform: (
                position: (0.0, 12.0, 0.0),
                rotation: (0.0, 0.3, 0.0, 0.95),
                scale: (0.8, 0.8, 0.8),
            ),
            model: "builtin://cube",
            id: (9),
            parent: None,
            physics: Some((kind: Dynamic, shape: Auto, restitution: 0.3)),
        ),

        // -- 圆柱：内置图元之一 --
        (
            name: "Pillar",
            transform: (
                position: (7.0, 1.5, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 3.0, 1.0),
            ),
            model: "builtin://cylinder",
            id: (10),
            parent: None,
            physics: Some((
                kind: Static,
                shape: Cylinder(half_height: 1.5, radius: 0.5),
            )),
        ),

        // -- 预制体实例：一棵"小场景"（柱基 + 中段 + 顶饰）--
        //    这里刻意**不给物理**：实例是纯视觉装饰，演示 `physics: None`
        //    的语义 —— 没有声明就不参与模拟，不会被重力拽走。
        (
            name: "Pillar",
            transform: (
                position: (-9.0, 0.5, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            model: "Resources/Box.glb",
            id: (11),
            parent: None,
            prefab: Some((
                source: "Prefabs/Pillar.prefab.ron",
                source_id: (1),
                is_root: true,
            )),
        ),
        (
            name: "Middle",
            transform: (
                position: (0.0, 1.2, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (1.0, 1.0, 1.0),
            ),
            model: "Resources/Box.glb",
            id: (12),
            parent: Some((11)),
            prefab: Some((
                source: "Prefabs/Pillar.prefab.ron",
                source_id: (2),
                is_root: false,
            )),
        ),
        (
            name: "Top",
            transform: (
                position: (0.0, 1.2, 0.0),
                rotation: (0.0, 0.0, 0.0, 1.0),
                scale: (0.6, 0.6, 0.6),
            ),
            model: "Resources/Box.glb",
            id: (13),
            parent: Some((12)),
            prefab: Some((
                source: "Prefabs/Pillar.prefab.ron",
                source_id: (3),
                is_root: false,
            )),
        ),
    ],
    lights: [
        (
            name: "Sun",
            kind: Directional,
            direction: (0.45, -1.0, 0.35),
            position: (0.0, 0.0, 0.0),
            color: (1.0, 0.97, 0.92),
            intensity: 3.2,
            range: 10.0,
            casts_shadow: true,
        ),
    ],
    ambient: (0.09, 0.10, 0.13),
)
